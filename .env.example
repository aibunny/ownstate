# Copy to .env for local development. Never commit real secrets.

# PostgreSQL (matches docker-compose.yml defaults)
OWNSTATE_DATABASE_URL=postgres://ownstate:ownstate_dev@127.0.0.1:5432/ownstate

# Integration tests create disposable migrated databases on a real PostgreSQL
# + pgvector server. The role needs CREATEDB; this is the harness default.
# The harness may drop its own test databases older than one hour.
# OWNSTATE_TEST_DATABASE_URL=postgres://ownstate:ownstate_dev@127.0.0.1:5432/ownstate

# HTTP API bind address
OWNSTATE_HTTP_ADDR=127.0.0.1:8080

# Platforms such as Railway inject PORT. It is used as 0.0.0.0:$PORT only
# when OWNSTATE_HTTP_ADDR is unset, so the explicit local address above wins.
# PORT=8080

# Unified Railway image process selector: api, worker, or mcp. The dedicated
# Compose image targets do not use this variable.
# OWNSTATE_PROCESS=api

# Deployment mode. Personal explicitly bootstraps local owner/service grants;
# Business defaults to deny and requires pre-provisioned principal credentials.
OWNSTATE_DEPLOYMENT_MODE=personal

# Static bearer token for the HTTP API. If unset, the API runs unauthenticated
# and logs a warning — local development only.
# OWNSTATE_API_TOKEN=change-me

# Optional curation credential. When set, promoting/rejecting candidates and
# HUMAN-attributed proposals require this token; the regular API token can
# only read and propose. Recommended whenever agents are bridged over HTTP.
# OWNSTATE_ADMIN_TOKEN=change-me-too

# A dedicated MCP token enables the API's authenticated Streamable HTTP `/mcp`
# endpoint in Personal mode. Keep it separate from API and admin credentials.
# In Business mode it must already be provisioned to the MCP service principal.
# OWNSTATE_MCP_TOKEN=change-me-mcp
# Extra comma-separated Host authorities accepted by remote MCP. Railway's
# RAILWAY_PUBLIC_DOMAIN is included automatically.
# OWNSTATE_MCP_ALLOWED_HOSTS=mcp.example.com
# Account website and user-owned OAuth MCP connections (Personal or Business mode).
# Set this to the public HTTPS origin of the API, without a trailing path.
# Signup remains disabled until the public URL and one email provider are configured.
# OWNSTATE_PUBLIC_URL=https://your-ownstate-domain.example
# On Railway Hobby, use Resend's HTTPS API; keep the key in Railway secrets.
# OWNSTATE_RESEND_API_KEY=set-as-a-deployment-secret
# Lark SMTP is available when the host permits outbound SMTP (Railway Pro).
OWNSTATE_SMTP_HOST=smtp.larksuite.com
OWNSTATE_SMTP_PORT=587
OWNSTATE_SMTP_FROM=ownstate@theaibunny.com
OWNSTATE_SMTP_USERNAME=ownstate@theaibunny.com
# OWNSTATE_SMTP_PASSWORD=set-as-a-deployment-secret
# Required in Business mode for the worker service principal.
# OWNSTATE_WORKER_TOKEN=change-me-worker

# Deployment-wide classification ceiling. Requests may ask for a lower
# ceiling but are always clamped to this maximum before retrieval.
# One of PUBLIC, INTERNAL, CONFIDENTIAL, RESTRICTED, SECRET.
OWNSTATE_MAX_CLASSIFICATION=CONFIDENTIAL

# Tenant for single-tenant (personal) deployments.
OWNSTATE_TENANT_ID=00000000-0000-0000-0000-000000000001

# Embedding provider: "fastembed" (local ONNX model, downloaded on first run)
# or "deterministic" (hash-based; dev/test only, no semantic quality).
OWNSTATE_EMBEDDING_PROVIDER=fastembed

# Directory where fastembed caches its model files.
OWNSTATE_EMBEDDING_CACHE_DIR=.fastembed_cache

# Run pending migrations automatically on startup: true/false/1/0.
# Compose gives migration ownership to the API.
OWNSTATE_AUTO_MIGRATE=true

# Positive worker poll interval in milliseconds when the queue is empty.
OWNSTATE_WORKER_POLL_MS=1000

# Log filter (tracing EnvFilter syntax)
RUST_LOG=info,ownstate_api=debug,ownstate_worker=debug

# Positive per-process PostgreSQL pool maximum.
OWNSTATE_MAX_DB_CONNECTIONS=10

# Compose-only container database endpoint (host binaries use the URL above).
# OWNSTATE_CONTAINER_DATABASE_URL=postgres://ownstate:ownstate_dev@postgres:5432/ownstate
# OWNSTATE_HTTP_PORT=8080
# OWNSTATE_POSTGRES_PORT=5432
# OWNSTATE_POSTGRES_CONTAINER_NAME=ownstate-postgres
# OWNSTATE_IMAGE_FASTEMBED=true
